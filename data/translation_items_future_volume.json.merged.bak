[
  {
    "external_id": "trans_fut_en_it_are_03",
    "source_lang": "en",
    "target_lang": "it",
    "source_text": "This evening we'll watch a film together.",
    "reference_translations": [
      { "text": "Stasera guarderemo un film insieme.", "register": "neutral", "notes": "Standard." }
    ],
    "topic": "verb_form.future",
    "register": "neutral",
    "difficulty": 2,
    "cefr_level_target": "A2",
    "required_buckets": ["verb_form.future.formation.regular_are"],
    "optional_buckets": [],
    "vocab_help": [
      { "lemma": "watch", "language": "en", "aspects": { "translation": { "reveal": "to watch / to look at - guardare", "bucket": "vocabulary.it.guardare.verb.translation" } } },
      { "lemma": "film", "language": "en", "aspects": { "translation": { "reveal": "film / movie - film", "bucket": "vocabulary.it.film.noun.translation" } } }
    ],
    "explanation": "Guardare is a regular -are verb, so the future shifts the theme vowel a to e: guarderemo (noi). Keeping the a (guardaremo) is the commonest -are slip.",
    "common_errors": [
      { "text": "Stasera guardaremo un film insieme.", "note": "WRONG: -are shifts a to e in the future; guarderemo, not guardaremo." }
    ],
    "version": 1
  },
  {
    "external_id": "trans_fut_en_it_are_04",
    "source_lang": "en",
    "target_lang": "it",
    "source_text": "Will you call me tomorrow?",
    "reference_translations": [
      { "text": "Mi chiamerai domani?", "register": "neutral", "notes": "Standard." }
    ],
    "topic": "verb_form.future",
    "register": "neutral",
    "difficulty": 2,
    "cefr_level_target": "A2",
    "required_buckets": ["verb_form.future.formation.regular_are"],
    "optional_buckets": [],
    "vocab_help": [
      { "lemma": "call", "language": "en", "aspects": { "translation": { "reveal": "to call / to phone - chiamare", "bucket": "vocabulary.it.chiamare.verb.translation" } } }
    ],
    "explanation": "Chiamare shifts a to e and takes the tu ending -ai: chiamerai. 'Domani' fixes the future.",
    "common_errors": [
      { "text": "Mi chiamarai domani?", "note": "WRONG: -are shifts a to e; chiamerai, not chiamarai." }
    ],
    "version": 1
  },
  {
    "external_id": "trans_fut_en_it_ere_03",
    "source_lang": "en",
    "target_lang": "it",
    "source_text": "They'll sell the house next year.",
    "reference_translations": [
      { "text": "Venderanno la casa l'anno prossimo.", "register": "neutral", "notes": "Standard." }
    ],
    "topic": "verb_form.future",
    "register": "neutral",
    "difficulty": 2,
    "cefr_level_target": "A2",
    "required_buckets": ["verb_form.future.formation.regular_ere"],
    "optional_buckets": [],
    "vocab_help": [
      { "lemma": "sell", "language": "en", "aspects": { "translation": { "reveal": "to sell - vendere", "bucket": "vocabulary.it.vendere.verb.translation" } } }
    ],
    "explanation": "Vendere is a regular -ere verb: the e stays and the loro ending -anno joins on, giving venderanno. It must not be syncopated (vendranno).",
    "common_errors": [
      { "text": "Vendranno la casa l'anno prossimo.", "note": "WRONG: vendere is regular in the future and keeps its e; venderanno, not the syncopated vendranno." }
    ],
    "version": 1
  },
  {
    "external_id": "trans_fut_en_it_ere_04",
    "source_lang": "en",
    "target_lang": "it",
    "source_text": "You'll receive a letter soon.",
    "reference_translations": [
      { "text": "Riceverai presto una lettera.", "register": "neutral", "notes": "Standard." }
    ],
    "topic": "verb_form.future",
    "register": "neutral",
    "difficulty": 2,
    "cefr_level_target": "A2",
    "required_buckets": ["verb_form.future.formation.regular_ere"],
    "optional_buckets": [],
    "vocab_help": [
      { "lemma": "receive", "language": "en", "aspects": { "translation": { "reveal": "to receive - ricevere", "bucket": "vocabulary.it.ricevere.verb.translation" } } }
    ],
    "explanation": "Ricevere is regular in the future: the e stays and the tu ending -ai joins on, giving riceverai. Don't syncopate it (ricevrai).",
    "common_errors": [
      { "text": "Ricevrai presto una lettera.", "note": "WRONG: ricevere is regular and keeps its e; riceverai, not the syncopated ricevrai." }
    ],
    "version": 1
  },
  {
    "external_id": "trans_fut_en_it_ire_02",
    "source_lang": "en",
    "target_lang": "it",
    "source_text": "Tonight we'll sleep at a hotel.",
    "reference_translations": [
      { "text": "Stanotte dormiremo in albergo.", "register": "neutral", "notes": "Standard." }
    ],
    "topic": "verb_form.future",
    "register": "neutral",
    "difficulty": 2,
    "cefr_level_target": "A2",
    "required_buckets": ["verb_form.future.formation.regular_ire"],
    "optional_buckets": [],
    "vocab_help": [
      { "lemma": "sleep", "language": "en", "aspects": { "translation": { "reveal": "to sleep - dormire", "bucket": "vocabulary.it.dormire.verb.translation" } } }
    ],
    "explanation": "Dormire is a regular -ire verb: the i stays and the noi ending -emo joins on, giving dormiremo (no theme-vowel shift in the -ire class).",
    "common_errors": [
      { "text": "Stanotte dormeremo in albergo.", "note": "WRONG: the -ire class keeps its i; dormiremo, not dormeremo." }
    ],
    "version": 1
  },
  {
    "external_id": "trans_fut_en_it_ire_03",
    "source_lang": "en",
    "target_lang": "it",
    "source_text": "They'll finish the work tomorrow.",
    "reference_translations": [
      { "text": "Finiranno il lavoro domani.", "register": "neutral", "notes": "Standard." }
    ],
    "topic": "verb_form.future",
    "register": "neutral",
    "difficulty": 2,
    "cefr_level_target": "A2",
    "required_buckets": ["verb_form.future.formation.regular_ire"],
    "optional_buckets": [],
    "vocab_help": [
      { "lemma": "finish", "language": "en", "aspects": { "translation": { "reveal": "to finish / to end - finire", "bucket": "vocabulary.it.finire.verb.translation" } } }
    ],
    "explanation": "Finire is an -isc- verb in the present (finisco) but the future drops the insert: finir- plus the loro ending -anno gives finiranno.",
    "common_errors": [
      { "text": "Finisciranno il lavoro domani.", "note": "WRONG: the present's -isc- does not appear in the future; finiranno, not finisciranno." }
    ],
    "version": 1
  },
  {
    "external_id": "trans_fut_en_it_orth_cg_02",
    "source_lang": "en",
    "target_lang": "it",
    "source_text": "We'll pay the bill this time.",
    "reference_translations": [
      { "text": "Pagheremo il conto questa volta.", "register": "neutral", "notes": "Standard." }
    ],
    "topic": "verb_form.future",
    "register": "neutral",
    "difficulty": 2,
    "cefr_level_target": "A2",
    "required_buckets": ["verb_form.future.formation.orthographic.care_gare"],
    "optional_buckets": [],
    "vocab_help": [
      { "lemma": "pay", "language": "en", "aspects": { "translation": { "reveal": "to pay - pagare", "bucket": "vocabulary.it.pagare.verb.translation" } } }
    ],
    "explanation": "Pagare ends in -gare, so an h goes in before the future -e- to keep the g hard: pagheremo. Without the h (pageremo) the g would soften.",
    "common_errors": [
      { "text": "Pageremo il conto questa volta.", "note": "WRONG: -gare inserts h before the future -e-; pagheremo, not pageremo." }
    ],
    "version": 1
  },
  {
    "external_id": "trans_fut_en_it_orth_cig_02",
    "source_lang": "en",
    "target_lang": "it",
    "source_text": "The lesson will begin at nine.",
    "reference_translations": [
      { "text": "La lezione comincerà alle nove.", "register": "neutral", "notes": "Standard." }
    ],
    "topic": "verb_form.future",
    "register": "neutral",
    "difficulty": 2,
    "cefr_level_target": "A2",
    "required_buckets": ["verb_form.future.formation.orthographic.ciare_giare"],
    "optional_buckets": [],
    "vocab_help": [
      { "lemma": "begin", "language": "en", "aspects": { "translation": { "reveal": "to begin / to start - cominciare", "bucket": "vocabulary.it.cominciare.verb.translation" } } }
    ],
    "explanation": "Cominciare ends in -ciare, so the redundant i is dropped before the future -e-: comincerà. Keeping the i (comincierà) is the slip.",
    "common_errors": [
      { "text": "La lezione comincierà alle nove.", "note": "WRONG: -ciare drops the redundant i before the future -e-; comincerà, not comincierà." }
    ],
    "version": 1
  },
  {
    "external_id": "trans_fut_en_it_irr_sync_04",
    "source_lang": "en",
    "target_lang": "it",
    "source_text": "You'll know the result tomorrow.",
    "reference_translations": [
      { "text": "Saprai il risultato domani.", "register": "neutral", "notes": "Standard." }
    ],
    "topic": "verb_form.future",
    "register": "neutral",
    "difficulty": 2,
    "cefr_level_target": "A2",
    "required_buckets": ["verb_form.future.formation.irregular.syncopated"],
    "optional_buckets": [],
    "vocab_help": [
      { "lemma": "know", "language": "en", "aspects": { "translation": { "reveal": "to know - sapere", "bucket": "vocabulary.it.sapere.verb.translation" } } }
    ],
    "explanation": "Sapere syncopates in the future: the theme vowel drops, giving the stem sapr- and then the tu ending -ai: saprai. Keeping the vowel (saperai) is the slip.",
    "common_errors": [
      { "text": "Saperai il risultato domani.", "note": "WRONG: sapere syncopates to sapr-; saprai, not saperai." }
    ],
    "version": 1
  },
  {
    "external_id": "trans_fut_en_it_irr_sync_05",
    "source_lang": "en",
    "target_lang": "it",
    "source_text": "She'll go to Rome by train.",
    "reference_translations": [
      { "text": "Andrà a Roma in treno.", "register": "neutral", "notes": "Standard. Subject pronoun dropped." }
    ],
    "topic": "verb_form.future",
    "register": "neutral",
    "difficulty": 2,
    "cefr_level_target": "A2",
    "required_buckets": ["verb_form.future.formation.irregular.syncopated"],
    "optional_buckets": [],
    "vocab_help": [
      { "lemma": "go", "language": "en", "aspects": { "translation": { "reveal": "to go - andare", "bucket": "vocabulary.it.andare.verb.translation" } } }
    ],
    "explanation": "Andare syncopates in the future: the theme vowel drops, giving andr- and then the 3sg ending -à: andrà. Even though andare is an -are verb, there is no a-to-e shift because the vowel is gone altogether.",
    "common_errors": [
      { "text": "Anderà a Roma in treno.", "note": "WRONG: andare syncopates to andr-; andrà, not anderà." }
    ],
    "version": 1
  },
  {
    "external_id": "trans_fut_en_it_irr_rr_03",
    "source_lang": "en",
    "target_lang": "it",
    "source_text": "We'll stay home tonight.",
    "reference_translations": [
      { "text": "Rimarremo a casa stasera.", "register": "neutral", "notes": "Standard." }
    ],
    "topic": "verb_form.future",
    "register": "neutral",
    "difficulty": 3,
    "cefr_level_target": "B1",
    "required_buckets": ["verb_form.future.formation.irregular.double_r"],
    "optional_buckets": [],
    "vocab_help": [
      { "lemma": "stay", "language": "en", "aspects": { "translation": { "reveal": "to stay / to remain - rimanere", "bucket": "vocabulary.it.rimanere.verb.translation" } } }
    ],
    "explanation": "Rimanere is a double-r verb: the stem assimilates to rimarr- and takes the noi ending -emo, giving rimarremo. A single r (rimaremo) is the slip.",
    "common_errors": [
      { "text": "Rimaremo a casa stasera.", "note": "WRONG: rimanere assimilates to the double-r stem rimarr-; rimarremo, not rimaremo." }
    ],
    "version": 1
  },
  {
    "external_id": "trans_fut_en_it_irr_ess_03",
    "source_lang": "en",
    "target_lang": "it",
    "source_text": "Tomorrow you'll be more rested.",
    "reference_translations": [
      { "text": "Domani sarai più riposato.", "register": "neutral", "notes": "Standard." }
    ],
    "topic": "verb_form.future",
    "register": "neutral",
    "difficulty": 2,
    "cefr_level_target": "A2",
    "required_buckets": ["verb_form.future.formation.irregular.essere"],
    "optional_buckets": [],
    "vocab_help": [
      { "lemma": "be", "language": "en", "aspects": { "translation": { "reveal": "to be - essere", "bucket": "vocabulary.it.essere.verb.translation" } } }
    ],
    "explanation": "Essere has the suppletive future stem sar-, then the tu ending -ai: sarai. Building it from the infinitive (esserai) is the slip.",
    "common_errors": [
      { "text": "Domani esserai più riposato.", "note": "WRONG: essere uses the suppletive stem sar-; sarai, not esserai." }
    ],
    "version": 1
  },
  {
    "external_id": "trans_fut_en_it_irr_ess_04",
    "source_lang": "en",
    "target_lang": "it",
    "source_text": "Next week we'll be on holiday.",
    "reference_translations": [
      { "text": "La settimana prossima saremo in vacanza.", "register": "neutral", "notes": "Standard." }
    ],
    "topic": "verb_form.future",
    "register": "neutral",
    "difficulty": 2,
    "cefr_level_target": "A2",
    "required_buckets": ["verb_form.future.formation.irregular.essere"],
    "optional_buckets": [],
    "vocab_help": [
      { "lemma": "be", "language": "en", "aspects": { "translation": { "reveal": "to be - essere", "bucket": "vocabulary.it.essere.verb.translation" } } }
    ],
    "explanation": "Essere's suppletive stem sar- takes the noi ending -emo: saremo. Never build it from the infinitive (esseremo).",
    "common_errors": [
      { "text": "La settimana prossima esseremo in vacanza.", "note": "WRONG: essere uses the suppletive stem sar-; saremo, not esseremo." }
    ],
    "version": 1
  },
  {
    "external_id": "trans_fut_en_it_irr_dsf_03",
    "source_lang": "en",
    "target_lang": "it",
    "source_text": "What will you do this weekend?",
    "reference_translations": [
      { "text": "Cosa farai questo weekend?", "register": "neutral", "notes": "Standard." }
    ],
    "topic": "verb_form.future",
    "register": "neutral",
    "difficulty": 2,
    "cefr_level_target": "A2",
    "required_buckets": ["verb_form.future.formation.irregular.dare_stare_fare"],
    "optional_buckets": [],
    "vocab_help": [
      { "lemma": "do", "language": "en", "aspects": { "translation": { "reveal": "to do / to make - fare", "bucket": "vocabulary.it.fare.verb.translation" } } }
    ],
    "explanation": "Fare keeps -ar- against the usual -are shift: far- plus the tu ending -ai gives farai. Applying the shift (ferai) over-generalises the rule.",
    "common_errors": [
      { "text": "Cosa ferai questo weekend?", "note": "WRONG: fare keeps -ar- in the future; farai, not ferai." }
    ],
    "version": 1
  },
  {
    "external_id": "trans_fut_en_it_fant_04",
    "source_lang": "en",
    "target_lang": "it",
    "source_text": "By tomorrow evening I'll have finished the report.",
    "reference_translations": [
      { "text": "Per domani sera avrò finito la relazione.", "register": "neutral", "notes": "Standard. Futuro anteriore: future of avere + participle." }
    ],
    "topic": "verb_form.future",
    "register": "neutral",
    "difficulty": 3,
    "cefr_level_target": "B1",
    "required_buckets": ["verb_form.future.formation.future_anteriore"],
    "optional_buckets": ["verb_form.future.formation.irregular.syncopated"],
    "vocab_help": [
      { "lemma": "finish", "language": "en", "aspects": { "translation": { "reveal": "to finish / to end - finire", "bucket": "vocabulary.it.finire.verb.translation" } } }
    ],
    "explanation": "An action completed before a future point takes the futuro anteriore: the future of avere (avrò) plus the participle finito, giving avrò finito. The simple future finirò would say 'I will finish', not 'I will have finished'.",
    "common_errors": [
      { "text": "Per domani sera finirò la relazione.", "note": "WRONG for the meaning: the simple future says 'I will finish'; 'I will have finished' before a future point needs the futuro anteriore (avrò finito)." }
    ],
    "version": 1
  }
]
