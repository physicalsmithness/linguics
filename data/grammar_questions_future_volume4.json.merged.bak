    "prompt_supplies_base_form": true,
    "markpoints": [
      { "order_index": 0, "credit": 1.0, "bucket": "verb_form.future.formation.future_anteriore", "label": "avrò scritto (future auxiliary + participle)", "any_phrases": [{ "phrase": "avrò scritto", "match_at": "word" }], "must_not_include": ["scriverò", "avrò scritti"] }
    ],
    "vocab_help": [
      { "lemma": "scrivere", "language": "it", "aspects": { "translation": { "reveal": "scrivere - to write", "bucket": "vocabulary.it.scrivere.verb.translation" } } }
    ],
    "explanation": "'By tomorrow evening, I'll have written the whole report': Per domani sera, io avrò scritto tutta la relazione. An action finished before a future point is the futuro anteriore: the future of avere (avrò) plus the participle scritto. The simple future scriverò would say 'I will write', not 'I will have written'. Scritto is avere's participle here and stays invariable (not scritti).",
    "examiner_note": "Frame-forced by 'per domani sera ... prima' (crit-21, excluding frame). avere participle invariable; scriverò is the wrong-tense catch.",
    "version": 1
  },
