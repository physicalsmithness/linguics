      { "order_index": 1, "credit": 1.0, "bucket": "verb_form.passato_prossimo.participle_agreement.with_essere.masculine_singular", "label": "participle agrees masculine singular (partito)", "any_phrases": [{ "phrase": "partito", "match_at": "word" }], "must_not_include": ["partita", "partiti"] }
